{
  "version": "0.2",
  "language": "en",
  "files": {
    "include": [
      "resources/views/layouts/**/*.blade.php"
    ]
  },
  "ignoreRegExpList": [
    "/{{.*?}}/g",
    "/@.*$/gm",
    "/class=\"[^\"]*\"/g",
    "/id=\"[^\"]*\"/g",
    "/\\$[a-zA-Z_][a-zA-Z0-9_]*/g",
    "/[.$#][a-zA-Z0-9_-]+/g",
    "/<script[\\s\\S]*?<\\/script>/gi",
    "/<style[\\s\\S]*?<\\/style>/gi"
  ],
  "words": [
    "Laravel",
    "Blade",
    "Eloquent",
    "Livewire",
    "Tailwind",
    "Filament",
    "Alpine",
    "csrf",
    "middleware",
    "datatable",
    "datepicker",
    "Datatables",
    "identityid",
    "fbconfirm",
    "Gloval",
    "Laracasts",
    "Messges",
    "sucess",
    "vfbox",
    "setp",
    "kiosklocked",
    "Dashboar",
    "CONFORME",
    "Consinder",
    "formno",
    "AppoverResponse",
    "timeentry",
    "attachement",
    "HDMF",
    "Whos",
    "Oher",
    "Pagibig"
  ]
}

